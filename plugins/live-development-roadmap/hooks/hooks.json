{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" pedido || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" pedido",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" editado || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" editado",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" comando || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" comando",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" cierre || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" cierre",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" corte || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" corte",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" inicio || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cierre_de_turno.py\" inicio",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
